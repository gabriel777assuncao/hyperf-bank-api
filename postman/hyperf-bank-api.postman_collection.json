		{
			"name": "5. Transfer (happy path)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status 201', () => pm.response.to.have.status(201));",
							"const json = pm.response.json();",
							"pm.test('Has transaction id', () => pm.expect(json.data.id).to.be.a('string').and.not.empty);",
							"pm.test('Status completed', () => pm.expect(json.data.status).to.eql('completed'));",
							"pm.test('Payer matches', () => pm.expect(json.data.payer_id).to.eql(pm.collectionVariables.get('payer_id')));",
							"pm.test('Payee matches', () => pm.expect(json.data.payee_id).to.eql(pm.collectionVariables.get('payee_id')));"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					},
					{
						"key": "Idempotency-Key",
						"value": "{{$guid}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"payee\": \"{{payee_id}}\",\n    \"value\": 100.00\n}"
				},
